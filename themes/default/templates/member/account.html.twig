{% extends 'layout.html.twig' %}

{% block title %}{{ 'theme.member.account.title'|trans }} — {{ setting('site_name')|default('Tallyst') }}{% endblock %}

{% block meta %}<meta name="robots" content="noindex">{% endblock %}

{% block body %}
    <article class="page-content">
        <header class="page-header">
            <h1>{{ 'theme.member.account.title'|trans }}</h1>
            <p class="member-identity">
                {{ member.email }} ·
                <a href="{{ path('member_logout') }}">{{ 'theme.member.account.logout'|trans }}</a>
            </p>
        </header>

        {# Blocks are contributed by whatever owns the data — purchases come from FormBuilder, and
           support and subscriptions will slot in the same way. This page never knows what they are. #}
        {% for block in blocks %}
            {{ include(block.template, block.data) }}
        {% else %}
            <div class="prose"><p>{{ 'theme.member.account.empty'|trans }}</p></div>
        {% endfor %}
    </article>
{% endblock %}
